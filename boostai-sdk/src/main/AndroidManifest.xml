<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- File picking goes through the Storage Access Framework (ACTION_GET_CONTENT), which
         needs no storage permission — the old READ/WRITE_EXTERNAL_STORAGE declarations merged
         into every consuming app's manifest for nothing, and conflicted with apps that cap the
         same permissions with maxSdkVersion. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- No android:exported here, deliberately. With no intent-filter the platform default
             is false, which is what we want: exporting let any third-party app launch the chat
             inside a consuming app with a customConfig of its choosing. Declaring false
             explicitly, though, is a hard manifest-merge error for every host that redeclares
             this activity with exported="true" (released versions shipped that value, and hosts
             have copied it alongside their own theme, the workaround for the non-AppCompat-theme
             crash); an omitted attribute merges with whatever the host declares. No
             android:theme either, for the same merge reason — the AppCompat fallback lives in
             ChatViewActivity.onCreate instead. -->
        <activity android:name=".UI.ChatViewActivity"/>
    </application>
</manifest>