<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="260dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="8dp"
    android:background="@drawable/rounded_card"
    android:clipToOutline="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/carousel_item_image"
        android:layout_width="260dp"
        android:layout_height="211dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/image" />

    <!-- Cards stretch to the tallest one in the row (match_parent inside a wrap_content
         horizontal LinearLayout), and the spacer below pins the button to the bottom so buttons
         line up across cards whose titles wrap to a different number of lines. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/carousel_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/carousel_item_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="17sp"
            android:lines="2"
            android:ellipsize="end" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/carousel_item_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_alt"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:paddingHorizontal="15dp"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Go to website" />

    </LinearLayout>

</LinearLayout>
